{
  "name": "@deckify/dsvg",
  "version": "0.1.0",
  "description": "Dynamic SVG (DSVG) 0.1 reference compiler — Yoga flexbox layout and Mustache templating for SVG",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "svg",
    "dsvg",
    "yoga",
    "flexbox",
    "mustache",
    "template"
  ],
  "homepage": "https://deckify.github.io/dsvg-standard/",
  "repository": {
    "type": "git",
    "url": "https://github.com/deckify/dsvg-standard.git",
    "directory": "implementations/typescript/dsvg"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build && pnpm run test && pnpm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@shuding/opentype.js": "^1.3.5",
    "svgson": "^5.3.1",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.5.2",
    "eslint": "^9.39.1",
    "eslint-plugin-jsdoc": "^63.3.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
